{
  "description": "Keeps the tools page and the upkeep notes current at the start of each session, and records each use of a tool.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "uv run --quiet --script \"${CLAUDE_PLUGIN_ROOT}/scripts/hook_session_start.py\" >/dev/null 2>&1 || true",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Skill",
        "hooks": [
          {
            "type": "command",
            "command": "uv run --quiet --script \"${CLAUDE_PLUGIN_ROOT}/scripts/hook_record_run.py\" >/dev/null 2>&1 || true",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
